{
  "manifestVersion": 1,
  "revision": 1,
  "name": "customer-bulk-item",
  "description": "The receipt for one record inside a bulk run: which record, what was attempted, and whether it applied. Applied plus failed always equals the run's item count exactly - a failed item never disappears quietly, and its code names the refusal that stopped it. An item applied by an earlier call of the same run keeps its single applied receipt; the resume reports it as already applied rather than writing a second one.",
  "table": "customer_bulk_items",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "required": false,
      "unique": true,
      "column": "source_key",
      "writable": "managed"
    },
    {
      "name": "runId",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "run_id",
      "writable": "managed"
    },
    {
      "name": "itemIndex",
      "type": "integer",
      "required": false,
      "unique": false,
      "column": "item_index",
      "writable": "managed"
    },
    {
      "name": "recordModule",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "record_module",
      "writable": "managed"
    },
    {
      "name": "recordId",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "record_id",
      "writable": "managed"
    },
    {
      "name": "outcome",
      "type": "enum",
      "required": false,
      "unique": false,
      "index": true,
      "column": "outcome",
      "writable": "managed",
      "values": [
        "applied",
        "failed"
      ]
    },
    {
      "name": "code",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "code",
      "writable": "managed"
    },
    {
      "name": "reason",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "reason",
      "writable": "managed"
    },
    {
      "name": "decidedAt",
      "type": "timestamp",
      "required": false,
      "unique": false,
      "column": "decided_at",
      "writable": "managed"
    }
  ]
}
