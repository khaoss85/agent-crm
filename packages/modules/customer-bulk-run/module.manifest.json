{
  "manifestVersion": 1,
  "revision": 1,
  "name": "customer-bulk-run",
  "description": "One bulk application of a customer-data record action across many records. The idempotency key is business-derived from the action name and the canonical digest of the items - never from a clock or a random value - so retrying the same bulk returns this same run, and an interrupted run stays in_progress with its per-item receipts until it is resumed. A run whose items did not all apply reads partial, never completed.",
  "table": "customer_bulk_runs",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "required": false,
      "unique": true,
      "column": "source_key",
      "writable": "managed"
    },
    {
      "name": "idempotencyKey",
      "type": "string",
      "required": false,
      "unique": true,
      "column": "idempotency_key",
      "writable": "managed"
    },
    {
      "name": "actionName",
      "type": "enum",
      "required": false,
      "unique": false,
      "column": "action_name",
      "writable": "managed",
      "values": [
        "link-canonical-identity",
        "dismiss-duplicate-candidate",
        "govern-data-quality-issue"
      ]
    },
    {
      "name": "status",
      "type": "enum",
      "required": false,
      "unique": false,
      "index": true,
      "column": "status",
      "writable": "managed",
      "values": [
        "in_progress",
        "completed",
        "partial"
      ]
    },
    {
      "name": "itemCount",
      "type": "integer",
      "required": false,
      "unique": false,
      "column": "item_count",
      "writable": "managed"
    },
    {
      "name": "appliedCount",
      "type": "integer",
      "required": false,
      "unique": false,
      "column": "applied_count",
      "writable": "managed"
    },
    {
      "name": "failedCount",
      "type": "integer",
      "required": false,
      "unique": false,
      "column": "failed_count",
      "writable": "managed"
    },
    {
      "name": "actorType",
      "type": "enum",
      "required": false,
      "unique": false,
      "column": "actor_type",
      "writable": "managed",
      "values": [
        "user",
        "agent",
        "system"
      ]
    },
    {
      "name": "actorId",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "actor_id",
      "writable": "managed"
    },
    {
      "name": "startedAt",
      "type": "timestamp",
      "required": false,
      "unique": false,
      "column": "started_at",
      "writable": "managed"
    },
    {
      "name": "finishedAt",
      "type": "timestamp",
      "required": false,
      "unique": false,
      "column": "finished_at",
      "writable": "managed"
    }
  ]
}
