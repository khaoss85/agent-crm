{
  "manifestVersion": 1,
  "revision": 1,
  "name": "channel-import-state",
  "description": "Progressive initial history import of one channel connection (backlog:66282d13d81c). One row per connection: the opaque provider cursor the next page resumes from, the window the run covers, and the phase plus the failure code. The row keeps no counters: the progress surface counts the channel-import-outcome rows carrying this row's sourceKey (one COUNT per state), so the number is always the rows themselves and no racing advance or crash retry can drift it.",
  "table": "channel_import_states",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "required": false,
      "unique": true,
      "column": "source_key",
      "writable": "managed"
    },
    {
      "name": "spaceId",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "space_id",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "connectionKey",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "connection_key",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "adapter",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "adapter",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "adapterVersion",
      "type": "integer",
      "required": false,
      "unique": false,
      "column": "adapter_version",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "status",
      "type": "enum",
      "required": false,
      "unique": false,
      "index": true,
      "column": "status",
      "writable": "managed",
      "values": [
        "running",
        "done"
      ],
      "classification": "non-personal"
    },
    {
      "name": "windowStart",
      "type": "timestamp",
      "required": false,
      "unique": false,
      "column": "window_start",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "nextPageToken",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "next_page_token",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "startedAt",
      "type": "timestamp",
      "required": false,
      "unique": false,
      "column": "started_at",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "finishedAt",
      "type": "timestamp",
      "required": false,
      "unique": false,
      "column": "finished_at",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "lastErrorCode",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "last_error_code",
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "lastErrorReason",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "last_error_reason",
      "writable": "managed",
      "classification": "non-personal"
    }
  ]
}
