      "type": "string",
      "required": false,
      "unique": false,
      "column": "evidence",
      "writable": "managed"
    },
    {
      "name": "detector",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "detector",
      "writable": "managed"
    },
    {
