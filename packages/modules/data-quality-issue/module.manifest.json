      "type": "string",
      "required": false,
      "unique": true,
      "column": "source_key",
      "writable": "managed"
    },
    {
      "name": "kind",
      "type": "enum",
      "required": false,
      "unique": false,
      "index": true,
      "column": "kind",
      "writable": "managed",
      "values": [
        "missing_required_identity",
        "conflicting_external_identity",
        "identity_conflict_windowed_scope",
        "invalid_email",
        "invalid_domain",
        "duplicate_candidate_open",
        "orphaned_reference",
        "unresolved_import_row"
      ]
    },
    {
      "name": "subjectResource",
