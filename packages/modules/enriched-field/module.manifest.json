      "type": "string",
      "required": false,
      "unique": true,
      "column": "source_key",
      "writable": "managed"
    },
    {
      "name": "subjectResource",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "subject_resource",
      "writable": "managed"
    },
    {
      "name": "subjectId",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "subject_id",
      "writable": "managed"
    },
    {
      "name": "subjectOwner",
      "type": "enum",
      "required": false,
      "unique": false,
      "column": "subject_owner",
      "writable": "managed",
      "values": [
        "host",
        "package"
      ]
    },
    {
      "name": "subjectOwnerPackage",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "subject_owner_package",
      "writable": "managed"
