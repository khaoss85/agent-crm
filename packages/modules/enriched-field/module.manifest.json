      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "field",
      "writable": "managed"
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "value",
      "writable": "managed"
    },
    {
      "name": "source",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "source",
      "writable": "managed"
    },
    {
      "name": "sourceDetail",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "source_detail",
      "writable": "managed"
    },
    {
