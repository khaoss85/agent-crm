{
  "manifestVersion": 1,
  "revision": 1,
  "name": "sales-playbook",
  "description": "The space's sales playbook: who the space is, what it sells, to whom, in what tone. One row per space, read and edited by the member; the AI proposes it from a site or a description but nothing is saved until the member confirms. Keyed by opaque control-plane space id.",
  "table": "sales_playbooks",
  "fields": [
    {
      "name": "spaceId",
      "type": "string",
      "required": false,
      "unique": true,
      "column": "space_id",
      "writable": "managed"
    },
    {
      "name": "companyName",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "company_name",
      "writable": "managed"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "description",
      "writable": "managed"
    },
    {
      "name": "website",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "website",
      "writable": "managed"
    },
    {
      "name": "products",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "products",
      "writable": "managed"
    },
    {
      "name": "idealCustomer",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "ideal_customer",
      "writable": "managed"
    },
    {
      "name": "tone",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "tone",
      "writable": "managed"
    },
    {
      "name": "avoidTopics",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "avoid_topics",
      "writable": "managed"
    },
    {
      "name": "links",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "links",
      "writable": "managed"
    },
    {
      "name": "hours",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "hours",
      "writable": "managed"
    }
  ]
}
