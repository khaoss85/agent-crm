{
  "manifestVersion": 1,
  "revision": 2,
  "name": "work-activity",
  "description": "An append-only, user-facing entry on a subject's work timeline. Its vocabulary is closed -- task_created, task_completed, task_cancelled, note -- and it is written only inside the transaction of the action that caused it. It is NOT a projection of the audit log: audit and trace stay the technical record of every write, and this is the curated semantic one. It stores no provider payload, no attachment, no email body and no chat message; the only free text is a bounded, control-character-free note body. taskId is a plain indexed string rather than a reference field because managed fields cannot be references, and because a timeline entry must survive being read beside a subject the database cannot join to.",
  "table": "work_activities",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "required": false,
      "unique": true,
      "column": "source_key",
      "writable": "managed"
    },
    {
      "name": "kind",
      "type": "enum",
      "required": false,
      "unique": false,
      "index": true,
      "column": "kind",
      "writable": "managed",
      "values": [
        "task_created",
        "task_completed",
        "task_cancelled",
        "note"
      ]
    },
    {
      "name": "subjectResource",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "subject_resource",
      "writable": "managed"
    },
    {
      "name": "subjectId",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "subject_id",
      "writable": "managed"
    },
    {
      "name": "taskId",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "task_id",
      "writable": "managed"
    },
    {
      "name": "body",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "body",
      "writable": "managed"
    },
    {
      "name": "occurredAt",
      "type": "timestamp",
      "required": false,
      "unique": false,
      "column": "occurred_at",
      "writable": "managed"
    },
    {
      "name": "actorType",
      "type": "enum",
      "required": false,
      "unique": false,
      "column": "actor_type",
      "writable": "managed",
      "values": [
        "user",
        "agent",
        "system"
      ]
    },
    {
      "name": "actorId",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "actor_id",
      "writable": "managed"
    },
    {
      "name": "sourcePackage",
      "type": "string",
      "required": false,
      "unique": false,
      "index": true,
      "column": "source_package",
      "writable": "managed"
    },
    {
      "name": "sourceAction",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "source_action",
      "writable": "managed"
    },
    {
      "name": "seq",
      "type": "integer",
      "required": false,
      "unique": false,
      "column": "seq",
      "writable": "managed"
    }
  ]
}
