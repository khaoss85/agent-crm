      "unique": false,
      "index": true,
      "column": "space_id",
      "writable": "managed"
    },
    {
      "name": "name",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "name",
      "writable": "managed"
    },
    {
      "name": "role",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "role",
      "writable": "managed"
    },
    {
      "name": "instructions",
      "type": "string",
      "required": false,
      "unique": false,
      "column": "instructions",
      "writable": "managed"
    },
    {
