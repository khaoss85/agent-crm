{
  "manifestVersion": 1,
  "name": "channel-import-state",
  "description": "Progressive initial history import of one channel connection (backlog:66282d13d81c). One row per connection: the opaque provider cursor the next page resumes from, the window the run covers, and the counts the progress surface reads. Rows are evidence of the provider past already stored as inbox rows — replaying a page stores nothing twice, so an interrupted import resumes from its cursor instead of restarting.",
  "fields": [
    { "name": "sourceKey", "type": "string", "unique": true, "writable": "managed" },
    { "name": "spaceId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "connectionKey", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "adapter", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "adapterVersion", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "status", "type": "enum", "values": ["running", "done"], "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "windowStart", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "nextPageToken", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "importedEvents", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "duplicateEvents", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "matchedContacts", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "createdContacts", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "unresolvedContacts", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "eventsWithoutSender", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "startedAt", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "finishedAt", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "lastErrorCode", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "lastErrorReason", "type": "string", "writable": "managed", "classification": "non-personal" }
  ]
}
