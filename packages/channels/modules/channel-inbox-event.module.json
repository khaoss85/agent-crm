{
  "manifestVersion": 1,
  "name": "channel-inbox-event",
  "description": "Append-only inbox of provider-verified channel webhook deliveries, one row per (space, connection, provider event id) (backlog:e5532d1c9146). Generalizes the M11 signature inbox to any channel adapter: verification before any write, DB-unique event identity plus payload fingerprint, quarantine for unknown subjects, an explicit effect per row, and a stable refusal that echoes nothing. Rows stored by the progressive initial history import carry that import's importKey (null for webhook rows), so a replayed page derives stored-by-this-import instead of recounting it.",
  "fields": [
    { "name": "sourceKey", "type": "string", "unique": true, "writable": "managed" },
    { "name": "spaceId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "connectionKey", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "importKey", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "adapter", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "adapterVersion", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "providerEventId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "subject", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "payloadFingerprint", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "sequence", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "occurredAt", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "receivedAt", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "processed", "type": "boolean", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "effect", "type": "enum", "values": ["pending", "applied", "ignored", "quarantined", "duplicate"], "writable": "managed", "classification": "non-personal" },
    { "name": "effectReason", "type": "string", "writable": "managed", "classification": "non-personal" }
  ]
}
