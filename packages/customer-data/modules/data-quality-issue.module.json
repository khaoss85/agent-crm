{
  "manifestVersion": 1,
  "name": "data-quality-issue",
  "description": "One explainable data-quality finding about a record Accordo owns, with the evidence that produced it. Governing an issue records a human decision and never erases the finding: a resolved issue keeps its history, and none of this is a compliance or legal-assurance claim.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "kind",
      "type": "enum",
      "values": [
        "missing_required_identity",
        "conflicting_external_identity",
        "invalid_email",
        "invalid_domain",
        "duplicate_candidate_open",
        "orphaned_reference",
        "unresolved_import_row"
      ],
      "index": true,
      "writable": "managed"
    },
    {
      "name": "subjectResource",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "subjectId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "subjectOwner",
      "type": "enum",
      "values": [
        "host",
        "package"
      ],
      "writable": "managed"
    },
    {
      "name": "subjectOwnerPackage",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "subjectLabel",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "evidence",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "detector",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "detectorVersion",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "detectedByRunId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "detectedAt",
      "type": "timestamp",
      "writable": "managed"
    },
    {
      "name": "status",
      "type": "enum",
      "values": [
        "open",
        "resolved",
        "dismissed"
      ],
      "index": true,
      "writable": "managed"
    },
    {
      "name": "resolutionReason",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "decidedByType",
      "type": "enum",
      "values": [
        "user"
      ],
      "writable": "managed"
    },
    {
      "name": "decidedById",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "decidedAt",
      "type": "timestamp",
      "writable": "managed"
    }
  ]
}
