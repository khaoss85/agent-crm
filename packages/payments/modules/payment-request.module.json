{
  "manifestVersion": 1,
  "name": "payment-request",
  "description": "One payment intent from a quote or an offer to its provider outcome (backlog:1972e16d33f2). The intent (open) is the local record; the external call creates the provider checkout or payment link (pending); the verified webhook finalizes it (paid, failed). Terminal states never regress. Amounts are integer minor units (ADR-014). No invoices: this record is the payment, not a fiscal document.",
  "fields": [
    { "name": "sourceKey", "type": "string", "unique": true, "writable": "managed" },
    { "name": "spaceId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "connectionKey", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "quoteId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "offerId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "amount", "type": "integer", "writable": "managed", "classification": "non-personal" },
    { "name": "currency", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "status", "type": "enum", "values": ["open", "pending", "paid", "failed", "canceled"], "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "statusReason", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "providerRef", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "providerUrl", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "paidAt", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "createdBy", "type": "string", "writable": "managed", "classification": "non-personal" }
  ]
}
