{
  "manifestVersion": 1,
  "name": "payment-event",
  "description": "One verified provider webhook item for one payment request (backlog:1972e16d33f2). Append-only replay-proof inbox: DB-unique per (space, connection, provider event id), so a redelivery resolves identically and a different payload under the same id is a provider contract violation (409), never a second payment. Unknown subjects quarantine as evidence.",
  "fields": [
    { "name": "sourceKey", "type": "string", "unique": true, "writable": "managed" },
    { "name": "spaceId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "connectionKey", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "providerEventId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "paymentRequestId", "type": "string", "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "eventType", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "payloadFingerprint", "type": "string", "writable": "managed", "classification": "non-personal" },
    { "name": "occurredAt", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "receivedAt", "type": "timestamp", "writable": "managed", "classification": "non-personal" },
    { "name": "processed", "type": "boolean", "writable": "managed", "classification": "non-personal" },
    { "name": "effect", "type": "enum", "values": ["applied", "ignored", "quarantined"], "index": true, "writable": "managed", "classification": "non-personal" },
    { "name": "effectReason", "type": "string", "writable": "managed", "classification": "non-personal" }
  ]
}
