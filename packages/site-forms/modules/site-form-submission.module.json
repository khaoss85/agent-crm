{
  "manifestVersion": 1,
  "name": "site-form-submission",
  "table": "site_form_submissions",
  "description": "One website-form request per row: the bounded fields the visitor typed, the resolved customer-data subject, the inbound website-form message it became, the reply channels the team answers on, and the spam verdict when it is refused. Every field is managed: a submission exists only through the site-forms package's open operation, and it moves pending -> accepted | rejected | needs-review only through its submit action. The raw IP is never stored — only its hash. (backlog:9d42035eca26)",
  "fields": [
    { "name": "sourceKey", "type": "string", "unique": true, "writable": "managed" },
    { "name": "spaceId", "type": "string", "index": true, "writable": "managed" },
    { "name": "status", "type": "enum", "values": ["pending", "accepted", "rejected", "needs-review"], "index": true, "writable": "managed" },
    { "name": "firstName", "type": "string", "writable": "managed" },
    { "name": "lastName", "type": "string", "writable": "managed" },
    { "name": "email", "type": "string", "writable": "managed" },
    { "name": "phone", "type": "string", "writable": "managed" },
    { "name": "companyName", "type": "string", "writable": "managed" },
    { "name": "body", "type": "string", "writable": "managed" },
    { "name": "ipHash", "type": "string", "index": true, "writable": "managed" },
    { "name": "honeypotFilled", "type": "boolean", "writable": "managed" },
    { "name": "dwellMs", "type": "integer", "writable": "managed" },
    { "name": "subjectResource", "type": "string", "writable": "managed" },
    { "name": "subjectId", "type": "string", "index": true, "writable": "managed" },
    { "name": "conversationId", "type": "string", "writable": "managed" },
    { "name": "messageId", "type": "string", "writable": "managed" },
    { "name": "replyWhatsapp", "type": "boolean", "writable": "managed" },
    { "name": "replyEmail", "type": "boolean", "writable": "managed" },
    { "name": "reasonCode", "type": "string", "writable": "managed" },
    { "name": "occurredAt", "type": "timestamp", "writable": "managed" },
    { "name": "decidedAt", "type": "timestamp", "writable": "managed" }
  ]
}
