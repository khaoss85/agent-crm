      "type": "string",
      "writable": "managed"
    },
    {
      "name": "policyObligationsJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "obligationsOverridden",
      "type": "boolean",
      "writable": "managed"
    },
    {
      "name": "obligationsOverrideReason",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "classificationReason",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "classificationPolicy",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "classificationPolicyVersion",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "classificationPolicyFingerprint",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "overriddenBy",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "position",
      "type": "integer",
      "writable": "managed"
    }
  ]
