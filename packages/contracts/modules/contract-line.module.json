{
  "manifestVersion": 1,
  "name": "contract-line",
  "description": "One immutable contract line per order component (M12), carrying the complete commercial snapshot plus BOTH classification axes — what the money is (commercial activation) and what is owed beyond it (obligations) — each with the policy decision, any human override and its reason. Every order component becomes exactly one contract line.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "contractId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "contractVersionId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "orderId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "orderLineId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "orderComponentId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "productId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "productVersionId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "offerId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "offerLogicalKey",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "offerRevision",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "offerName",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "sku",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "componentId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "componentKey",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "label",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "chargeType",
      "type": "enum",
      "values": [
        "one_time",
        "recurring"
      ],
      "writable": "managed"
    },
    {
      "name": "pricingModel",
      "type": "enum",
      "values": [
        "flat_fee",
        "per_unit",
        "volume",
        "graduated"
      ],
      "writable": "managed"
    },
    {
      "name": "interval",
      "type": "enum",
      "values": [
        "month",
        "year"
      ],
      "writable": "managed"
    },
    {
      "name": "intervalCount",
      "type": "integer",
      "writable": "managed"
    },
    {
