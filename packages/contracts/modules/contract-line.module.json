      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "unitAmountCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "flatAmountCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "tiersJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "tierBreakdownJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "listAmountCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "discountAmountCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "netAmountCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "currency",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "provider",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "externalPriceId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "sourcePricingModel",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "commercialActivation",
      "type": "enum",
      "values": [
        "subscription",
        "non_subscription"
      ],
      "writable": "managed"
    },
    {
      "name": "policyCommercialActivation",
      "type": "enum",
      "values": [
        "subscription",
        "non_subscription",
        "ambiguous"
      ],
      "writable": "managed"
    },
    {
      "name": "commercialOverridden",
      "type": "boolean",
      "writable": "managed"
