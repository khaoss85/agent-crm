{
  "manifestVersion": 1,
  "name": "commercial-contract",
  "description": "One active commercial agreement per activated signed order (M12). Its commercial content is copied from the immutable Order and never recalculated from the live catalog. No cancellation, suspension, renewal or amendment behavior exists in this milestone. The term is operational metadata recorded after signature (termsSource) — the signed document package carries no term, so it is never presented as a signed commercial term.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "orderId",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "quoteId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "quoteVersionId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "envelopeId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "signedArtifactId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "opportunityId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "companyId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "contactId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "customerName",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "customerEmail",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "currency",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "status",
      "type": "enum",
      "values": [
        "scheduled",
        "active"
      ],
      "writable": "managed"
    },
    {
      "name": "effectiveDate",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "termStartDate",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "termEndDate",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "termDays",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "autoRenew",
      "type": "boolean",
      "writable": "managed"
    },
    {
      "name": "renewalNoticeDays",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "termsSource",
      "type": "enum",
      "values": [
        "post-signature-operational-activation"
      ],
      "writable": "managed"
    },
    {
      "name": "termsReason",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "policy",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "policyVersion",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "policyFingerprint",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "documentHash",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "artifactHash",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "sourceFingerprint",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "currentVersionId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "activationId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "activatedAt",
      "type": "timestamp",
      "writable": "managed"
    }
  ]
}
