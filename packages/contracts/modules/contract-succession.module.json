{
  "manifestVersion": 1,
  "name": "contract-succession",
  "description": "The immutable lineage between one commercial agreement and the successor agreement that replaces it (M16b, ADR-035). Written once, in the same transaction as the successor Contract, and never rewritten. Three UNIQUE columns carry the whole guarantee: a source contract has at most one successor, a successor has at most one predecessor, and a signed Order is consumed at most once. Nothing here amends, ends, cancels, bills or renews anything: the source contract row is not modified by this record's creation, and no scheduler exists.",
  "fields": [
    { "name": "sourceKey", "type": "string", "unique": true, "writable": "managed" },
    { "name": "sourceContractId", "type": "string", "unique": true, "writable": "managed" },
    { "name": "sourceContractVersionId", "type": "string", "writable": "managed" },
    { "name": "sourceSubscriptionId", "type": "string", "writable": "managed" },
    { "name": "sourceOrderId", "type": "string", "index": true, "writable": "managed" },
    { "name": "successorContractId", "type": "string", "unique": true, "writable": "managed" },
    { "name": "successorContractVersionId", "type": "string", "writable": "managed" },
    { "name": "successorSubscriptionId", "type": "string", "writable": "managed" },
    { "name": "successorOrderId", "type": "string", "unique": true, "writable": "managed" },
    { "name": "successorActivationId", "type": "string", "writable": "managed" },
    { "name": "executionRef", "type": "string", "unique": true, "writable": "managed" },
    { "name": "companyId", "type": "string", "index": true, "writable": "managed" },
    { "name": "customerName", "type": "string", "writable": "managed" },
    { "name": "currency", "type": "string", "writable": "managed" },
    {
      "name": "classification",
      "type": "enum",
      "values": ["renewal", "expansion", "contraction", "mixed", "commercial_change"],
      "index": true,
      "writable": "managed"
    },
    { "name": "classificationBasis", "type": "string", "writable": "managed" },
    { "name": "deltaJson", "type": "string", "writable": "managed" },
    { "name": "addedLineCount", "type": "integer", "writable": "managed" },
    { "name": "removedLineCount", "type": "integer", "writable": "managed" },
    { "name": "changedLineCount", "type": "integer", "writable": "managed" },
    { "name": "unchangedLineCount", "type": "integer", "writable": "managed" },
    { "name": "sourceTermStartDate", "type": "string", "writable": "managed" },
    { "name": "sourceTermEndDate", "type": "string", "writable": "managed" },
    { "name": "sourceTermsSource", "type": "string", "writable": "managed" },
    { "name": "sourceTermSigned", "type": "boolean", "writable": "managed" },
    { "name": "successorTermStartDate", "type": "string", "writable": "managed" },
    { "name": "successorTermEndDate", "type": "string", "writable": "managed" },
    { "name": "successorTermsSource", "type": "string", "writable": "managed" },
    { "name": "successorTermsFingerprint", "type": "string", "writable": "managed" },
    {
      "name": "termContinuity",
      "type": "enum",
      "values": ["contiguous", "gap", "overlap", "unknown"],
      "writable": "managed"
    },
    { "name": "termGapDays", "type": "integer", "writable": "managed" },
    { "name": "documentHash", "type": "string", "writable": "managed" },
    { "name": "policy", "type": "string", "writable": "managed" },
    { "name": "policyVersion", "type": "integer", "writable": "managed" },
    { "name": "policyFingerprint", "type": "string", "writable": "managed" },
    { "name": "executedBy", "type": "string", "writable": "managed" },
    { "name": "executedAt", "type": "timestamp", "writable": "managed" }
  ]
}
