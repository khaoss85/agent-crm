  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "orderComponentId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "position",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "upToQuantity",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "unitAmountCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "flatAmountCents",
      "type": "integer",
      "writable": "managed"
    }
  ]
}
