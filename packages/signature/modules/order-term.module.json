{
  "manifestVersion": 1,
  "name": "order-term",
  "description": "The signed commercial term of one immutable Order (ADR-017 discipline): copied from the quote version's term snapshot at verified completion, in the same transaction as the Order, after the rebuilt document — terms included — reproduced the signed documentHash. Written once and never rewritten. Absent for orders whose signed document carried no term; absence is historical fact, never backfilled.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "orderId",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "quoteVersionId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "effectiveDate",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "termStartDate",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "termEndDate",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "termDays",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "autoRenew",
      "type": "boolean",
      "writable": "managed"
    },
    {
      "name": "renewalNoticeDays",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "termsContract",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "termsFingerprint",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "documentHash",
      "type": "string",
      "writable": "managed"
    }
  ]
}
