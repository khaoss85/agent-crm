{
  "manifestVersion": 1,
  "name": "delivery-economic-snapshot",
  "description": "One immutable, reproducible computation of a delivery project's economics, grouped by currency and citing the evidence it was computed from. These are operational delivery estimates: no revenue is recognized, no invoice amount is implied and no accounting margin is computed.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "writable": "managed",
      "unique": true
    },
    {
      "name": "deliveryProjectId",
      "type": "string",
      "writable": "managed",
      "index": true
    },
    {
      "name": "economicPlanId",
      "type": "string",
      "writable": "managed",
      "index": true
    },
    {
      "name": "economicPlanVersion",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "basis",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "groupsJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "currencyCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "timeEntryCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "expenseEntryCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "planLineCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "workPackageCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "roundingRule",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "note",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "calculatedBy",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "calculatedAt",
      "type": "timestamp",
      "writable": "managed"
    }
  ]
}
