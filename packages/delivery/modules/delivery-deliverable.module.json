{
 "manifestVersion": 1,
 "name": "delivery-deliverable",
 "description": "Something a delivery project produces, tied to server-authoritative execution state. Completing one says the work finished; it never says anyone accepted it. No file, binary or document is stored here.",
 "fields": [
  {
   "name": "sourceKey",
   "type": "string",
   "writable": "managed",
   "unique": true
  },
  {
   "name": "deliveryProjectId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "deliveryWorkPackageId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "deliveryMilestoneId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "label",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "scopeSnapshot",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "status",
   "type": "enum",
   "writable": "managed",
   "values": [
    "planned",
    "completed"
   ]
  },
  {
   "name": "completionEvidenceRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "completedBy",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "completedAt",
   "type": "timestamp",
   "writable": "managed"
  },
  {
   "name": "plannedBy",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "plannedAt",
   "type": "timestamp",
   "writable": "managed"
  }
 ]
}
