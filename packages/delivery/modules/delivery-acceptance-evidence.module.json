   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "deliveryAcceptanceRequestId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "scopeFingerprint",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "outcome",
   "type": "enum",
   "writable": "managed",
   "values": [
    "accepted",
    "rejected"
   ]
  },
  {
   "name": "assertedCustomerRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "assertedContactRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "note",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "evidenceRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "recordedBy",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "recordedAt",
   "type": "timestamp",
   "writable": "managed"
  }
 ]
}
