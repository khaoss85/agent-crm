{
  "manifestVersion": 1,
  "name": "delivery-expense-entry",
  "description": "One immutable record of an expense consumed on a work package of a running delivery project. It is evidence, not an invoice: nothing is verified, reimbursed, paid or attached, and no receipt or document is stored.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "writable": "managed",
      "unique": true
    },
    {
      "name": "deliveryProjectId",
      "type": "string",
      "writable": "managed",
      "index": true
    },
    {
      "name": "deliveryWorkPackageId",
      "type": "string",
      "writable": "managed",
      "index": true
    },
    {
      "name": "expenseDate",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "category",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "amountCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "currency",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "vendorRef",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "partnerEngagementId",
      "type": "string",
      "writable": "managed",
      "index": true
    },
    {
      "name": "evidenceRef",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "note",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "recordedBy",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "recordedAt",
      "type": "timestamp",
      "writable": "managed"
    }
  ]
}
