{
  "manifestVersion": 1,
  "name": "delivery-partner-engagement",
  "description": "A planned third-party delivery partner for one project (M13). It is a business reference and a name snapshot: it grants no account, no login, no portal, no permission, no fee or revenue share and no SLA, and this milestone models at most one partner per project.",
