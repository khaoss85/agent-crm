{
 "manifestVersion": 1,
 "name": "delivery-commercial-change",
 "description": "An immutable candidate for a future commercial amendment, raised when an approved change has commercial consequence. It is a handoff, never an amendment: no Quote, Order, Contract, Contract Version or Subscription is created or altered, no amount is recognized and nothing is sent. A human records what the commercial follow-up concluded outside this application — resolved_externally or withdrawn — which is what stops a raised candidate blocking acceptance evidence forever.",
 "fields": [
  {
   "name": "sourceKey",
   "type": "string",
   "writable": "managed",
   "unique": true
  },
  {
   "name": "deliveryProjectId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "deliveryChangeRequestId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "contractId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "summary",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "estimatedDeltaCents",
   "type": "integer",
   "writable": "managed"
  },
  {
   "name": "currency",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "status",
   "type": "enum",
   "writable": "managed",
   "values": [
    "pending_commercial_followup",
    "resolved_externally",
    "withdrawn"
   ]
  },
  {
   "name": "resolutionReason",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "resolutionEvidenceRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "resolvedBy",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "resolvedAt",
   "type": "timestamp",
   "writable": "managed"
  },
  {
   "name": "raisedBy",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "raisedAt",
   "type": "timestamp",
   "writable": "managed"
  }
 ]
}
