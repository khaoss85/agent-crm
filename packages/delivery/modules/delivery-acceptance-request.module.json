{
 "manifestVersion": 1,
 "name": "delivery-acceptance-request",
 "description": "An immutable record that acceptance was asked for: which milestone and deliverables, which customer contact reference, and when. Nothing is emailed, no portal exists and no customer is authenticated — this records that a human submitted the work for acceptance.",
 "fields": [
  {
   "name": "sourceKey",
   "type": "string",
   "writable": "managed",
   "unique": true
  },
  {
   "name": "deliveryProjectId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "deliveryMilestoneId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "deliverableRefs",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "customerRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "customerContactRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "customerNameSnapshot",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "evidenceRef",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "status",
   "type": "enum",
   "writable": "managed",
   "values": [
    "pending",
    "accepted",
    "rejected"
   ]
  },
  {
   "name": "requestedBy",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "requestedAt",
   "type": "timestamp",
   "writable": "managed"
  }
 ]
}
