{
 "manifestVersion": 1,
 "name": "delivery-plan-revision",
 "description": "One immutable version of a delivery project's revised future plan, created by approving a non-commercial change request. It never rewrites the M13 handover snapshot, the signed Order or any completed historical work — it describes what is planned from here.",
 "fields": [
  {
   "name": "sourceKey",
   "type": "string",
   "writable": "managed",
   "unique": true
  },
  {
   "name": "deliveryProjectId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "deliveryChangeRequestId",
   "type": "string",
   "writable": "managed",
   "index": true
  },
  {
   "name": "version",
   "type": "integer",
   "writable": "managed"
  },
  {
   "name": "revisedScope",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "revisedStartDate",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "revisedEndDate",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "reason",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "createdBy",
   "type": "string",
   "writable": "managed"
  },
  {
   "name": "revisedAt",
   "type": "timestamp",
   "writable": "managed"
  }
 ]
}
