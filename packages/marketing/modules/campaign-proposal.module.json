{
  "manifestVersion": 1,
  "name": "campaign-proposal",
  "description": "What the agent proposes and what a human reads: one complete, coherent, reviewable campaign before anything exists in a provider (MK1). A proposal that cannot state every required section is refused, never half-approved.",
  "fields": [
    {
      "name": "insightId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "title",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "mode",
      "type": "enum",
      "values": [
        "one-shot",
        "rolling",
        "triggered",
        "journey"
      ],
      "default": "one-shot",
      "writable": "managed"
    },
    {
      "name": "audienceJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "exclusionsJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "channel",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "providerRationale",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "contentPlanJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "trackingPlanJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "risksJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "requiredApprovalsJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "status",
      "type": "enum",
      "values": [
        "draft",
        "proposed",
        "approved",
        "refused"
      ],
      "default": "draft",
      "writable": "managed"
    },
    {
      "name": "refusalReasonsJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "proposedAt",
      "type": "timestamp",
      "writable": "managed"
    },
    {
      "name": "decidedBy",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "decidedAt",
      "type": "timestamp",
      "writable": "managed"
    },
    {
      "name": "currentVersionId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "policyName",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "policyVersion",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "policyFingerprint",
      "type": "string",
      "writable": "managed"
    }
  ]
}
