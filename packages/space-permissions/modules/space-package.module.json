{
  "manifestVersion": 1,
  "name": "space-package",
  "description": "Per-space package and skill composition (backlog:7543aabbd901, BO-F4-01 Personalizzazione). One row per (space, unit): activating a package or a skill in a space records the composition here; deactivating marks it removed, never deletes history. Read-only publicly: every field is managed, so rows exist only through the package's activate operation.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "spaceId",
      "type": "string",
      "index": true,
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "unit",
      "type": "string",
      "index": true,
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "kind",
      "type": "enum",
      "values": [
        "package",
        "skill"
      ],
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "status",
      "type": "enum",
      "values": [
        "active",
        "removed"
      ],
      "default": "active",
      "index": true,
      "writable": "managed",
      "classification": "non-personal"
    },
    {
      "name": "activatedBy",
      "type": "string",
      "writable": "managed",
      "required": false,
      "classification": "non-personal"
    },
    {
      "name": "activatedAt",
      "type": "string",
      "writable": "managed",
      "required": false,
      "classification": "non-personal"
    },
    {
      "name": "removedAt",
      "type": "string",
      "writable": "managed",
      "required": false,
      "classification": "non-personal"
    }
  ]
}
