{
  "mcpServers": {
    "accordo": {
      "command": "node",
      "args": ["--no-warnings", "./packages/mcp/bin/server.js"],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "writes",
      "env": {
        "CRM_DB_PATH": "./data/accordo.sqlite"
      }
    }
  }
}
