node_modules/
.env
.env.*
!.env.example
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
# Test-coverage output, at the repository ROOT only. Anchored deliberately:
# unanchored, `coverage/` matches at any depth, and it silently swallowed
# `docs/jtbd/coverage/` — `git add -A` skipped the directory without a word and
# published a tree missing a file `docs/jtbd/AGENTS.md` cites by name.
/coverage/
.DS_Store
*.log
.tmp/

# Built site output — regenerate with `npm run site:build`
site/dist/

# Build receipt written by scripts/site-build.js — not published, not read by anything else.
site/.used-claims.json

# Staging left behind by an interrupted `crm package scaffold`. It holds no
# lock and blocks nothing; the command reports it so a human can remove it.
packages/.scaffold-*
**/.scaffold-*

# Screenshots from the render audit — a local artifact, never published.
site/.render-check/

# Local Vercel project metadata and pulled preview credentials.
.vercel/
.env.local

# Deterministic Vercel Function corpus, assembled during the build.
packages/docs-mcp/runtime-corpus/

# Python bytecode — never tracked. A tools/ import during verification generates it.
__pycache__/
*.pyc
