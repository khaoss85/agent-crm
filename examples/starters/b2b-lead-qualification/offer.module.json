{
  "manifestVersion": 1,
  "name": "offer",
  "description": "A sellable commercial package (rate plan) for one product version: one or more price components mixing one-time and recurring charges. Versioned as a whole \u2014 any pricing change creates a new immutable revision (ADR-016).",
  "fields": [
    {
      "name": "logicalKey",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "revision",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "sourceKey",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "priceBookId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "productId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "productVersionId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "name",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "currency",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "active",
      "type": "boolean",
      "writable": "managed"
    },
    {
      "name": "quoteEligible",
      "type": "boolean",
      "writable": "managed"
    },
    {
      "name": "unsupportedReason",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "provider",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "providerVersion",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "providerFingerprint",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "externalOfferId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "componentCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "sourceFingerprint",
      "type": "string",
      "writable": "managed"
    }
  ]
}
