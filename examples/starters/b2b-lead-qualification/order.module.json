{
  "manifestVersion": 1,
  "name": "order",
  "description": "One immutable Order per completed signed quote version (ADR-017). Every commercial figure is copied from the approved quote version snapshot, never re-read from the live catalog. No fulfillment, billing or payment status exists in this milestone.",
  "fields": [
    {
      "name": "sourceKey",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "quoteId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "quoteVersionId",
      "type": "string",
      "unique": true,
      "writable": "managed"
    },
    {
      "name": "envelopeId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "signedArtifactId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "opportunityId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "companyId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "contactId",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "customerName",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "customerEmail",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "currency",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "status",
      "type": "enum",
      "values": [
        "accepted"
      ],
      "writable": "managed"
    },
    {
      "name": "versionNumber",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "policy",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "policyVersion",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "policyDecision",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "documentHash",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "artifactHash",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "totalsJson",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "oneTimeNetCents",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "recurringGroupCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "lineCount",
      "type": "integer",
      "writable": "managed"
    },
    {
      "name": "acceptedAt",
      "type": "timestamp",
      "writable": "managed"
    },
    {
      "name": "sourceFingerprint",
      "type": "string",
      "writable": "managed"
    },
    {
      "name": "contractId",
      "type": "string",
      "index": true,
      "writable": "managed"
    },
    {
      "name": "activatedAt",
      "type": "timestamp",
      "writable": "managed"
    }
  ]
}
